   "source": [
    "def binary_one_positions_with_count(n):\n",
    "    binary_str = bin(n)[2:]\n",
    "    positions = [i + 1 for i, bit in enumerate(binary_str) if bit == '1' ]\n",
    "    return [len(positions)] + positions \n",
    "    return positions\n",
    "\n",
    "# Example usage\n",
    "result = binary_one_positions_with_count(161)\n",
    "display(result)"
   ]
  }
